{
  "name": "groq-writer",
  "version": "1.1.1",
  "description": "A Grammarly-style writing assistant for Chrome and Firefox, powered by Groq or any OpenAI-compatible API.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/aryanarin/groq-writer",
