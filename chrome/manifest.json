{
  "manifest_version": 3,
  "name": "Groq Writer",
  "version": "1.1.1",
  "description": "A Grammarly-style writing assistant for Groq, OpenAI, and any OpenAI-compatible API. Fixes spelling and grammar as you type.",
  "homepage_url": "https://github.com/aryanarin/groq-writer",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Groq Writer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "rewrite-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open the Groq Writer menu for the selected text"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Turn Groq Writer on or off"
    },
    "tone-shortcut": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Quick rewrite the selected text (mode is set in settings)"
    },
    "translate-shortcut": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Quick translate the selected text (language is set in settings)"
    }
  }
}
